y and grammatical structures, and with intelligible pronunciation."}, {"type": "secondary_5", "content": " Communicates effectively in English about the communicative topics for this level through the use of appropriate basic vocabulary and grammatical structures, and with intelligible pronunciation."}, {"type": "secondary_6", "content": " Communicates effectively in English about the communicative topics for this level through the use of appropriate basic vocabulary and grammatical structures, and with intelligible pronunciation."}, {"type": "secondary_7", "content": " Communicates effectively in English about the communicative topics for this level through the use of appropriate basic vocabulary and grammatical structures, and with intelligible pronunciation."}, {"type": "secondary_8", "content": " Communicates effectively in English about the communicative topics for this level through the use of appropriate basic vocabulary and grammatical structures, and with intelligible pronunciation."}]}, {"type": "learning_points", "contents": [{"type": "heading", "content": " Modal Verbs for Polite Requests"}, {"type": "describer", "content": "You use the modal verbs, <span class=\"italic\">can, could</span>  and <span class=\"italic\">would</span>  to make polite requests when you are on an airplane."}, {"type": "table", "content": "{\"rows\":4,\"columns\":2,\"cells\":[\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"<span class =\\\"strong\\\"> Modal Verb </span>\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"<span class =\\\"strong\\\"> Polite Request </span>\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"can\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"<span class=\\\"italic\\\"> Can I have some coffee, please? </span>\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\" could\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"<span class=\\\"italic\\\"> Could you bring me some water? </span>\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\" would\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"<span class=\\\"italic\\\"> Would you get me a snack, please? </span>\\\"}\"],\"styles\":\" instruction_table_background intro_table_border\"}"}, {"type": "example", "content": "<span class =\"strong\">Traveler</span>: Can I have some coffee, please?  <br> <span class =\"strong\">Flight Attendant</span>: Of course. <br> "}, {"type": "example", "content": "<span class =\"strong\">Traveler</span>: Would you get me a snack, please? <br> <span class =\"strong\">Flight Attendant</span>: Certainly."}]}, {"type": "target_word", "contents": [{"type": "name", "content": "silverware "}, {"type": "definition", "content": "knives, forks and spoons made of silver "}, {"type": "part_speech", "content": "(noun)  "}, {"type": "example", "content": "Example: In first class, they use real silverware, not plastic."}, {"type": "audio", "content": "engenn3le09ob05aud01"}]}, {"type": "target_word_describer", "contents": [{"type": "text", "content": " These are words you hear when you fly first class."}]}, {"type": "target_word", "contents": [{"type": "name", "content": "eye mask "}, {"type": "definition", "content": "a dark cloth to cover your eyes when sleeping "}, {"type": "part_speech", "content": "(noun)  "}, {"type": "example", "content": "Example: There is an eye mask in here for you."}, {"type": "audio", "content": "engenn3le09ob05aud02"}]}, {"type": "target_word", "contents": [{"type": "name", "content": "hand cream"}, {"type": "definition", "content": "a thick liquid to put on dry hands  "}, {"type": "part_speech", "content": " (noun)  "}, {"type": "example", "content": "Example: I need some hand cream. My hands are very dry."}, {"type": "audio", "content": "engenn3le09ob05aud03"}]}, {"type": "target_word", "contents": [{"type": "name", "content": "to welcome "}, {"type": "definition", "content": "to greet in a friendly way  "}, {"type": "part_speech", "content": "(verb)  "}, {"type": "example", "content": "Example: Welcome to first class."}, {"type": "audio", "content": "engenn3le09ob05aud04"}]}, {"type": "target_word", "contents": [{"type": "name", "content": "to recline "}, {"type": "definition", "content": "to push into a horizontal position "}, {"type": "part_speech", "content": "(verb)"}, {"type": "example", "content": "Example: You can recline the seat when you sleep."}, {"type": "audio", "content": "engenn3le09ob05aud05"}]}, {"type": "target_word", "contents": [{"type": "name", "content": "snack "}, {"type": "definition", "content": " a small amount of food "}, {"type": "part_speech", "content": "(noun) "}, {"type": "example", "content": "Example: Have a snack while you wait for the meal."}, {"type": "audio", "content": "engenn3le09ob05aud06"}]}, {"type": "target_word", "contents": [{"type": "name", "content": "to get used to "}, {"type": "definition", "content": "to become accustomed to  "}, {"type": "part_speech", "content": "(verb)  "}, {"type": "example", "content": "Example: I could get used to traveling first class."}, {"type": "audio", "content": "engenn3le09ob05aud07"}]}, {"type": "target_word", "contents": [{"type": "name", "content": "flight attendant "}, {"type": "definition", "content": "an airline worker "}, {"type": "part_speech", "content": "(noun)  "}, {"type": "example", "content": "Example: The flight attendant helps passengers."}, {"type": "audio", "content": "engenn3le09ob05aud08"}]}, {"type": "target_word", "contents": [{"type": "name", "content": "travel kit "}, {"type": "definition", "content": "a small set of things used for travel  "}, {"type": "part_speech", "content": "(noun)  "}, {"type": "example", "content": "Example: This travel kit contains hand cream and an eye mask."}, {"type": "audio", "content": "engenn3le09ob05aud09"}]}, {"type": "background_image", "content": "engenn3le09ob05re1img01.jpg"}, {"type": "takeaway_extension", "contents": [{"type": "text", "content": "Imagine you are traveling on a plane."}, {"type": "text", "content": "Write a dialogue making a request for something."}, {"type": "text", "content": "Write the flight attendant's response."}, {"type": "text", "content": "Write 2 more requests and responses."}, {"type": "text", "content": "Practice the dialogue aloud. "}]}, {"type": "takeaway_assessment", "contents": [{"type": "text", "content": "I talk about air travel."}, {"type": "text", "content": "I make requests using words like <span class=\"italic\">can</span>, <span class=\"italic\">could</span>, <span class=\"italic\">would</span> to make requests."}, {"type": "text", "content": "I respond to requests on a plane."}]}], "type": "sena"}