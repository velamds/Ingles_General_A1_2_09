tents": [{"type": "skill", "content": "Reading"}, {"type": "skill", "content": "Writing"}, {"type": "skill", "content": "Speaking"}]}, {"type": "post_instructions", "contents": [{"type": "text", "content": "Instructions: Complete the following steps. Fill in the Self-Assessment. "}]}], "template_override": 1}], "id": 0, "type": "scholar", "_data": [{"type": "lab_options", "contents": [{"type": "has_nav", "content": true}, {"type": "has_exercise_controls", "content": true}]}]}], "_data": [{"type": "metadata", "contents": [{"type": "lesson_name", "content": "At the Airport"}, {"type": "unit_name", "content": "Getting a New Travel Bag"}, {"type": "position", "content": 8}, {"type": "origin", "content": "stub"}, {"type": "lesson", "content": 9}, {"type": "level", "content": "A1.2"}]}, {"type": "achievment_test", "contents": [{"type": "test", "content": "false"}]}, {"type": "objectives", "contents": [{"type": "primary", "content": "Accurately explain information about  interests, hobbies, and preferences in communicative situations."}, {"type": "secondary_1", "content": "Writes simple but clear texts describing or reviewing places to visit in the region, using an appropriate range of vocabulary and grammatical structures."}, {"type": "secondary_2", "content": "Communicates effectively in English about the communicative topics for this level through the use of appropriate basic vocabulary and grammatical structures, and with intelligible pronunciation."}, {"type": "secondary_3", "content": "Writes simple but clear texts describing or reviewing places to visit in the region, using an appropriate range of vocabulary and grammatical structures."}, {"type": "secondary_4", "content": "Writes simple but clear texts describing or reviewing places to visit in the region, using an appropriate range of vocabulary and grammatical structures."}, {"type": "secondary_5", "content": "Writes simple but clear texts describing or reviewing places to visit in the region, using an appropriate range of vocabulary and grammatical structures."}, {"type": "secondary_6", "content": "Communicates effectively in English about the communicative topics for this level through the use of appropriate basic vocabulary and grammatical structures, and with intelligible pronunciation."}, {"type": "secondary_7", "content": "Communicates effectively in English about the communicative topics for this level through the use of appropriate basic vocabulary and grammatical structures, and with intelligible pronunciation."}, {"type": "secondary_8", "content": "Communicates effectively in English about the communicative topics for this level through the use of appropriate basic vocabulary and grammatical structures, and with intelligible pronunciation."}]}, {"type": "learning_points", "contents": [{"type": "heading", "content": " Writing a Product Review"}, {"type": "describer", "content": " <br>A product review is a report that gives someone's opinion about the quality of a product. You can use the Simple Present tense when you write a product review.<br>  <br>To write a review, you must include:<br> <br><span class=\"strong\">Features</span>:  information on what the product does and details.<br>  <br><span class=\"strong\">Target group</span>: information on who uses the product and why they would want to use it.<br>  <br><span class=\"strong\">Pros and Cons</span>: An opinion about the positives and negatives of the product.<br>  <br><span class=\"strong\">Overall opinion</span>: Your opinion of the product.<br><br/><span class = \"italic\">Example</span>: <br/>Do you like to cook?<br/>(<span class = \"strong\">Target Group</span>)Our cookware is perfect for the busy parent! <br/>(<span class = \"strong\">Features</span>)It has stainless steel handles, so you won't burn yourself!<br/>(<span class = \"strong\">Pros/Cons</span>)It's large enough to cook an entire roast, but can get quite heavy!<br/>(<span class = \"strong\">Overall opinion</span>)I would say this product is overall a smart choice."}]}, {"type": "target_word", "contents": [{"type": "name", "content": "consumer"}, {"type": "definition", "content": "a person who buys goods and services"}, {"type": "part_speech", "content": "(noun)"}, {"type": "example", "content": "Example: Many consumers buy over the Internet."}, {"type": "audio", "content": "engenn3le09ob08aud01"}]}, {"type": "target_word_describer", "contents": [{"type": "text", "content": "These are words you hear in a conversation about shopping."}]}, {"type": "target_word", "contents": [{"type": "name", "content": "guide"}, {"type": "definition", "content": "a book or magazine that provides information about a subject "}, {"type": "part_speech", "content": "(noun)"}, {"type": "example", "content": "Example: The magazine is a guide for travelers."}, {"type": "audio", "content": "engenn3le09ob08aud02"}]}, {"type": "target_word", "contents": [{"type": "name", "content": "product"}, {"type": "definition", "content": "something that is made or grown to be sold or used "}, {"type": "part_speech", "content": "(noun)"}, {"type": "example", "content": "Example: The company sells many products on the Internet."}, {"type": "audio", "content": "engenn3le09ob08aud03"}]}, {"type": "target_word", "contents": [{"type": "name", "content": "pocket"}, {"type": "definition", "content": "an open bag that you can put things in"}, {"type": "part_speech", "content": "(noun)"}, {"type": "example", "content": "Example: It has a pocket for your boarding pass."}, {"type": "audio", "content": "engenn3le09ob08aud04"}]}, {"type": "target_word", "contents": [{"type": "name", "content": "guarantee"}, {"type": "definition", "content": "a written promise about the quality of a  product or service "}, {"type": "part_speech", "content": "(noun)"}, {"type": "example", "content": "Example: This luggage has a 10 year guarantee."}, {"type": "audio", "content": "engenn3le09ob08aud05"}]}, {"type": "target_word", "contents": [{"type": "name", "content": "handle"}, {"type": "definition", "content": "a part of something that is designed to be held  hand"}, {"type": "part_speech", "content": "(noun)"}, {"type": "example", "content": "Example: The handle on my travel bag is broken."}, {"type": "audio", "content": "engenn3le09ob08aud06"}]}, {"type": "target_word", "contents": [{"type": "name", "content": "to expand"}, {"type": "definition", "content": "to get bigger "}, {"type": "part_speech", "content": "(verb)"}, {"type": "example", "content": "Example: The travel bag expands two inches."}, {"type": "audio", "content": "engenn3le09ob08aud07"}]}, {"type": "background_image", "content": "engenn3le09ob08re1img01.jpg"}, {"type": "learning_points", "contents": [{"type": "heading", "content": "Verbs With the Infinitive"}, {"type": "describer", "content": "Infinitives always start with to followed by the simple form of the verb, like this: To + Verb = Infinitive</br>The infinitive is the basic form of the word.</br> Infinitives are not verbs, you cannot add s, es, ed, or ing to the end."}, {"type": "example", "content": "I don't want to spend too much."}, {"type": "example", "content": "There are so many bags to choose from."}, {"type": "example", "content": "You need to get a new suitcase"}]}, {"type": "takeaway_extension", "contents": [{"type": "text", "content": "Choose an item you bought in the last month."}, {"type": "text", "content": "Write a 75-word product review."}, {"type": "text", "content": "Include features, pros and cons, practical details, who should buy the product and opinion."}, {"type": "text", "content": "Share your review."}]}, {"type": "takeaway_assessment", "contents": [{"type": "text", "content": "I write complete sentences for a product review."}, {"type": "text", "content": "I write about pros, cons and features of a product."}, {"type": "text", "content": "I share my review with a partner."}]}], "type": "sena"}