ntents": [{"value": {"images": [{"text": "", "id": 0, "time": "0", "image": "engenn3le09ob04re2img02.jpg"}, {"text": "<span class=\"strong\">Female</span>: Excuse me. You dropped your ticket. <br>\n<span class=\"strong\">Vanessa</span>: Oh, thank you very much. You're on flight 981 too?<br>\n<span class=\"strong\">Female</span>: Yes, I'm going to visit my parents. They are having their 50th wedding anniversary party this weekend.<br>\n<span class=\"strong\">Vanessa</span>: That sounds like fun. Wow ... 50 years ... that's amazing.<br>", "id": 1, "time": "100", "image": "engenn3le09ob04re2img05.jpg"}, {"text": "<span class=\"strong\">Female</span>: Your ticket is a different color to mine. Where are you sitting?<br>\n<span class=\"strong\">Vanessa</span>: First class. Yesterday, I decided to upgrade my ticket.<br>\n<span class=\"strong\">Female</span>: That's nice for you! There's better food, more legroom and ... you get your luggage first!<br>\n<span class=\"strong\">Vanessa</span>: It was a birthday gift to myself.<br>", "id": 2, "time": "21500", "image": "engenn3le09ob04re2img05.jpg"}, {"text": "<span class=\"strong\">Female</span>: Well, my ticket's not yellow, mine's green ...  back of the plane for me.<br>\n<span class=\"strong\">Vanessa</span>: I am usually there too! I hope the flight is not delayed or canceled.  The weather outside is terrible.<br>\n<span class=\"strong\">Female</span>: Sounds like we are boarding. Well, first class passengers anyway. Safe flight!<br>\n<span class=\"strong\">Vanessa</span>: You too! Enjoy the celebration.<br>", "id": 3, "time": "42000", "image": "engenn3le09ob04re2img02.jpg"}], "audiosrc": "engenn3le09ob04re2aud01", "coverimg": "engenn3le09ob04re2img02.jpg"}, "type": "slideshow"}], "_data": [], "type": "audio", "template_override": 1}]}]}